{
  "name": "boarddock",
  "productName": "BoardDock",
  "version": "3.1.1",
  "description": "3D-printable, screwless holders for any PCB, docked onto DIN rails with a push-button release: auto-fit to the board and its plugs, panel layout for plug access, FEA checks, plate-packed STL/3MF export.",
  "license": "MIT",
  "author": "BoardDock contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "boards": "node scripts/boards.mjs",
    "parts": "node scripts/parts.mjs",
    "collisions": "vitest run --config vitest.collide.config.ts",
    "collisions:update": "vitest run --config vitest.collide.config.ts --mode update --fileParallelism=false",
    "desktop": "vite build && electron .",
    "dist": "vite build && electron-builder --publish never"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.3",
    "occt-import-js": "^0.0.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "homepage": "https://github.com/danmover/boarddock",
  "repository": {
    "type": "git",
    "url": "https://github.com/danmover/boarddock.git"
  },
  "keywords": [
    "pcb",
    "din-rail",
    "3d-printing",
    "enclosure",
    "kicad",
    "altium",
    "gerber",
    "step",
    "fea",
    "manifold"
  ],
  "build": {
    "appId": "io.github.boarddock",
    "productName": "BoardDock",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BoardDock-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "BoardDock-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Engineering",
      "icon": "build/icon.png",
      "maintainer": "BoardDock contributors <noreply@github.com>"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "danmover",
        "repo": "boarddock"
      }
    ],
    "artifactName": "BoardDock-${version}-${os}-${arch}.${ext}"
  }
}
